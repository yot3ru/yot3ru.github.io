---
export type IconName =
  | 'arrow-left'
  | 'arrow-right'
  | 'arrow-up'
  | 'arrow-up-right'
  | 'external';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['lufi-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-left' && (
    <path d="M 20.01 12 H 4.01 M 8.01 17 L 6.24 15.25 C 4.84 13.86 4.14 13.16 4.03 12.31 C 3.99 12.11 3.99 11.89 4.03 11.69 C 4.14 10.84 4.84 10.14 6.24 8.75 L 8.01 7" />
  )}
  {name === 'arrow-right' && (
    <path d="M 3.99 12 L 19.99 12 M 15.99 7 L 17.76 8.75 C 19.16 10.14 19.86 10.84 19.97 11.69 C 20.01 11.89 20.01 12.11 19.97 12.31 C 19.86 13.16 19.16 13.86 17.76 15.25 L 15.99 17" />
  )}
  {name === 'arrow-up' && (
    <path d="M 12 20 L 12 4 M 7 8 L 8.75 6.24 C 10.14 4.83 10.84 4.13 11.69 4.02 C 11.89 4 12.11 4 12.31 4.02 C 13.16 4.13 13.86 4.83 15.25 6.24 L 17 8" />
  )}
  {name === 'arrow-up-right' && (
    <g transform="rotate(45 12 12)">
      <path d="M 12 20 L 12 4 M 7 8 L 8.75 6.24 C 10.14 4.83 10.84 4.13 11.69 4.02 C 11.89 4 12.11 4 12.31 4.02 C 13.16 4.13 13.86 4.83 15.25 6.24 L 17 8" />
    </g>
  )}
  {name === 'external' && (
    <path d="M 12.71 4.61 C 12.11 4.60 11.45 4.60 10.71 4.60 C 6.96 4.60 5.09 4.60 3.77 5.55 C 3.35 5.86 2.97 6.23 2.66 6.66 C 1.71 7.97 1.71 9.85 1.71 13.60 C 1.71 17.35 1.71 19.22 2.66 20.54 C 2.97 20.96 3.35 21.33 3.77 21.64 C 5.09 22.60 6.96 22.60 10.71 22.60 C 14.46 22.60 16.33 22.60 17.65 21.64 C 18.07 21.33 18.45 20.96 18.76 20.54 C 19.71 19.22 19.71 17.35 19.71 13.60 C 19.71 12.86 19.71 12.20 19.70 11.60 M 22.27 8.50 L 22.28 6.01 C 22.29 4.04 22.29 3.05 21.77 2.37 C 21.70 2.29 21.64 2.21 21.56 2.14 C 21.49 2.06 21.41 1.99 21.32 1.93 C 20.65 1.40 19.66 1.41 17.68 1.41 L 15.20 1.43 M 10.25 13.45 L 21.54 2.15 L 21.56 2.14" />
  )}
</svg>
