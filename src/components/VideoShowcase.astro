---
import Icon from './Icon.astro';
import { videoWorks, type VideoWork } from '../data/videoWork';

interface Props {
  title?: string;
  accent?: string;
  id?: string;
  works?: VideoWork[];
}

const {
  title = 'Moving',
  accent = 'image.',
  id = 'film',
  works = videoWorks,
} = Astro.props;

const titleId = `${id}-title`;

const aspectPadding = (ratio?: string) => {
  if (!ratio) return '56.25%';
  const [w, h] = ratio.split('/').map(Number);
  if (!w || !h) return '56.25%';
  return `${((h / w) * 100).toFixed(4).replace(/\.?0+$/, '')}%`;
};
---

<section
  class="video-showcase section-pad"
  id={id}
  aria-labelledby={titleId}
  data-motion-section
  data-surface="light"
  data-video-showcase
>
  <div class="video-showcase__heading">
    <h2 id={titleId} class="motion-heading">
      <span class="motion-line">
        <span>{title}{accent && <> <em>{accent}</em></>}</span>
      </span>
    </h2>

    {works.length > 1 && (
      <div class="video-showcase__arrows" aria-label="Video navigation">
        <button
          class="video-nav-btn"
          type="button"
          aria-label="Previous video"
          disabled
          data-video-prev
        >
          <Icon name="arrow-left" />
        </button>
        <button
          class="video-nav-btn"
          type="button"
          aria-label="Next video"
          data-video-next
        >
          <Icon name="arrow-right" />
        </button>
      </div>
    )}
  </div>

  <div class="video-showcase__stage" data-video-stage>
    <div
      class="video-showcase__track"
      role="region"
      aria-roledescription="carousel"
      aria-label="Video showcase"
      tabindex="0"
      data-video-track
    >
      {works.map((work, index) => {
        const embedUrl = work.vimeoId
          ? `https://player.vimeo.com/video/${work.vimeoId}?autopause=0&player_id=0&app_id=58479&outro=nothing`
          : `https://drive.google.com/file/d/${work.driveId}/preview`;
        const isVimeo = Boolean(work.vimeoId);

        return (
          <article
            class="video-slide"
            id={`video-slide-${work.id}`}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${works.length}: ${work.title}`}
            data-video-slide
            data-slide-index={index}
          >
            <div class="video-card">
              <div
                class="video-card__frame"
                style={`padding-bottom: ${aspectPadding(work.aspectRatio)};`}
                data-video-frame
                data-embed-src={embedUrl}
                data-video-title={work.title}
                data-video-index={work.indexLabel}
                data-direct-embed={isVimeo ? 'true' : undefined}
              >
                <div class="video-card__backdrop" aria-hidden="true">
                  <span class="video-card__watermark">{work.indexLabel}</span>
                </div>

                {!isVimeo && (
                  <button
                    class="video-card__trigger"
                    type="button"
                    aria-label={`Play ${work.title}`}
                    data-video-trigger
                  >
                    <span class="video-card__badge" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M8.5 5.5v13l10.5-6.5z" />
                      </svg>
                    </span>
                  </button>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .video-showcase {
    background: var(--bone);
    color: var(--ink);
    padding-block: var(--space-section-y);
    overflow: visible;
  }

  .video-showcase__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
    max-width: var(--content);
    margin: 0 auto var(--space-4);
  }

  .video-showcase h2 {
    margin: 0;
    min-width: 0;
    font-size: var(--type-section);
    line-height: var(--leading-display);
  }

  .video-showcase h2 .motion-line > span {
    white-space: nowrap;
  }

  @media (max-width: 440px) {
    .video-showcase__heading {
      flex-wrap: wrap;
    }
  }

  .video-showcase h2 em {
    color: var(--red);
  }

  .video-showcase__arrows {
    flex: none;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .video-nav-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(24, 23, 21, 0.25);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-soft),
      border-color var(--duration-fast) var(--ease-out-soft),
      color var(--duration-fast) var(--ease-out-soft),
      transform var(--duration-fast) var(--ease-spring),
      opacity var(--duration-fast) var(--ease-out-soft);
  }

  .video-nav-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .video-nav-btn:not(:disabled):hover,
  .video-nav-btn:not(:disabled):focus-visible {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bone);
  }

  .video-nav-btn:not(:disabled):active {
    transform: scale(0.95);
  }

  .video-nav-btn:disabled {
    opacity: 0.28;
    cursor: not-allowed;
  }

  .video-nav-btn:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  .video-showcase__stage {
    width: auto;
    margin-inline: calc(-1 * var(--p));
    min-width: 0;
  }

  .video-showcase__track {
    --track-pad: max(var(--p), calc((100% - var(--content)) / 2));
    position: relative;
    display: flex;
    gap: var(--track-pad);
    width: 100%;
    min-width: 0;
    padding-left: var(--track-pad);
    scroll-padding-left: var(--track-pad);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .video-showcase__track::after {
    content: "";
    flex: 0 0 1px;
    margin-left: -1px;
  }

  .video-showcase__track::-webkit-scrollbar {
    display: none;
  }

  .video-showcase__track:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 6px;
  }

  .video-slide {
    flex: 0 0 calc(100% - 2 * var(--track-pad));
    width: calc(100% - 2 * var(--track-pad));
    min-width: calc(100% - 2 * var(--track-pad));
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .video-card {
    padding: var(--radius-pad);
    background: var(--ink);
    border: 1px solid rgba(24, 23, 21, 0.16);
    border-radius: var(--radius-frame);
  }

  .video-card__frame {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%;
    overflow: hidden;
    background: #0d0c0b;
    border-radius: var(--radius-inner);
  }

  @supports (corner-shape: squircle) {
    .video-card,
    .video-card__frame,
    .video-card__frame :global(.video-card__iframe) {
      corner-shape: squircle;
    }
  }

  .video-card__backdrop {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: end start;
    padding: clamp(0.85rem, 2vw, 1.5rem);
    background:
      radial-gradient(circle at 78% 22%, rgba(205, 71, 76, 0.2), transparent 55%),
      linear-gradient(145deg, #211f1c 0%, #181715 100%);
    pointer-events: none;
  }

  .video-card__watermark {
    font: 650 clamp(2.5rem, 6vw, 4.5rem) / 0.9 Funnel, sans-serif;
    letter-spacing: -0.05em;
    color: rgba(235, 231, 224, 0.14);
    user-select: none;
  }

  .video-card__trigger {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    min-height: 44px;
    border: 0;
    padding: 0;
    margin: 0;
    background: linear-gradient(180deg, rgba(24, 23, 21, 0.06) 0%, rgba(24, 23, 21, 0.34) 100%);
    color: var(--bone);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color var(--duration-fast) ease;
  }

  .video-card__trigger:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: -4px;
  }

  .video-card__badge {
    width: clamp(3.5rem, 6.5vw, 5rem);
    height: clamp(3.5rem, 6.5vw, 5rem);
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: rgba(235, 231, 224, 0.94);
    color: var(--ink);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    transition:
      transform var(--duration-fast) var(--ease-out-primary),
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .video-card__badge svg {
    width: 38%;
    height: 38%;
    fill: currentColor;
    transform: translateX(6%);
  }

  .video-card__frame :global(.video-card__iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius-inner);
    display: block;
    background: #000;
    z-index: 3;
  }

  @media (hover: hover) and (pointer: fine) {
    .video-card__trigger:hover {
      background: linear-gradient(180deg, rgba(24, 23, 21, 0.02) 0%, rgba(24, 23, 21, 0.2) 100%);
    }
    .video-card__trigger:hover .video-card__badge {
      transform: scale(1.08);
      background: var(--red);
      color: var(--bone);
    }
  }

  /* Motion reveal */
  :global(.motion-ready) [data-video-showcase] .video-showcase__arrows {
    opacity: 0;
    transform: translate3d(0, var(--distance-xs), 0);
    transition: opacity var(--duration-base) var(--ease-out-soft), transform var(--duration-base) var(--ease-out-soft);
  }
  :global(.motion-ready) [data-video-showcase][data-in-view] .video-showcase__arrows {
    opacity: 1;
    transform: none;
  }
  :global(.motion-ready) [data-video-showcase] .video-showcase__stage {
    opacity: 0;
    transform: translate3d(0, var(--distance-sm), 0);
    transition: opacity var(--duration-reveal) var(--ease-out-soft), transform var(--duration-reveal) var(--ease-out-primary);
  }
  :global(.motion-ready) [data-video-showcase][data-in-view] .video-showcase__stage {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-showcase__track {
      scroll-behavior: auto;
    }
    .video-card__trigger,
    .video-card__badge,
    .video-nav-btn,
    :global(.motion-ready) [data-video-showcase] .video-showcase__arrows,
    :global(.motion-ready) [data-video-showcase] .video-showcase__stage {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-showcase]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-video-track]');
    const slides = [...section.querySelectorAll<HTMLElement>('[data-video-slide]')];
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-video-prev]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-video-next]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    if (!track || !slides.length) return;

    let activeIndex = 0;
    let lastWidth = track.clientWidth;
    let suppressScrollSync = false;
    let programmaticTarget: number | null = null;
    let programmaticTimer = 0;
    let scrollFrame = 0;

    const clearProgrammatic = () => {
      programmaticTarget = null;
      clearTimeout(programmaticTimer);
    };

    const getTargetLeft = (index: number) => {
      const baseLeft = slides[0]?.offsetLeft ?? 0;
      return (slides[index]?.offsetLeft ?? baseLeft) - baseLeft;
    };

    const getNearestSlideIndex = () => {
      let bestIndex = activeIndex;
      let bestDist = Infinity;
      slides.forEach((_, i) => {
        const dist = Math.abs(track.scrollLeft - getTargetLeft(i));
        if (dist < bestDist) {
          bestDist = dist;
          bestIndex = i;
        }
      });
      return bestIndex;
    };

    const mountIframe = (frame: HTMLElement) => {
      if (frame.dataset.playing === 'true') return;
      const embedSrc = frame.dataset.embedSrc;
      const title = frame.dataset.videoTitle || 'Video player';
      if (!embedSrc) return;

      frame.dataset.playing = 'true';
      const iframe = document.createElement('iframe');
      iframe.className = 'video-card__iframe';
      iframe.src = embedSrc;
      iframe.title = title;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;

      if (embedSrc.includes('player.vimeo.com')) {
        iframe.addEventListener('load', () => {
          iframe.contentWindow?.postMessage(JSON.stringify({ method: 'addEventListener', value: 'ended' }), 'https://player.vimeo.com');
          iframe.contentWindow?.postMessage(JSON.stringify({ method: 'addEventListener', value: 'finish' }), 'https://player.vimeo.com');
        });
      }

      frame.querySelector('[data-video-trigger]')?.remove();
      frame.querySelector('.video-card__backdrop')?.remove();
      frame.append(iframe);
    };

    const resetSlide = (frame: HTMLElement) => {
      const iframe = frame.querySelector<HTMLIFrameElement>('.video-card__iframe');
      const embedSrc = frame.dataset.embedSrc;
      if (iframe && embedSrc) {
        iframe.src = embedSrc;
      }
    };

    const updateUI = (index: number) => {
      const prevIndex = activeIndex;
      activeIndex = Math.max(0, Math.min(index, slides.length - 1));
      if (prevBtn) prevBtn.disabled = activeIndex === 0;
      if (nextBtn) nextBtn.disabled = activeIndex === slides.length - 1;

      const activeFrame = slides[activeIndex]?.querySelector<HTMLElement>('[data-video-frame]');
      if (activeFrame?.dataset.directEmbed === 'true') mountIframe(activeFrame);

      if (prevIndex !== activeIndex) {
        const prevFrame = slides[prevIndex]?.querySelector<HTMLElement>('[data-video-frame]');
        if (prevFrame && prevFrame.dataset.playing === 'true') resetSlide(prevFrame);
      }
    };

    const goToSlide = (index: number, instant = false) => {
      const target = Math.max(0, Math.min(index, slides.length - 1));
      const targetLeft = getTargetLeft(target);
      const useInstant = instant || reduced.matches;
      updateUI(target);

      if (useInstant) {
        clearProgrammatic();
        suppressScrollSync = true;
        track.style.scrollBehavior = 'auto';
        track.scrollLeft = targetLeft;
        track.style.scrollBehavior = '';
        requestAnimationFrame(() => {
          suppressScrollSync = false;
        });
      } else {
        programmaticTarget = target;
        clearTimeout(programmaticTimer);
        programmaticTimer = window.setTimeout(clearProgrammatic, 700);
        track.scrollTo({ left: targetLeft, behavior: 'smooth' });
      }
    };

    const mountActiveEmbed = () => {
      const frame = slides[activeIndex]?.querySelector<HTMLElement>('[data-video-frame]');
      if (frame?.dataset.directEmbed === 'true') mountIframe(frame);
    };

    if (typeof IntersectionObserver !== 'undefined') {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          mountActiveEmbed();
          obs.disconnect();
        });
      }, { rootMargin: '320px 0px' });
      observer.observe(section);
    } else {
      mountActiveEmbed();
    }

    slides.forEach((slide) => {
      const frame = slide.querySelector<HTMLElement>('[data-video-frame]');
      const trigger = frame?.querySelector<HTMLButtonElement>('[data-video-trigger]');
      if (frame && trigger) {
        trigger.addEventListener('click', () => mountIframe(frame));
      }
    });

    prevBtn?.addEventListener('click', () => goToSlide(activeIndex - 1));
    nextBtn?.addEventListener('click', () => goToSlide(activeIndex + 1));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goToSlide(activeIndex + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goToSlide(activeIndex - 1);
      }
    });

    track.addEventListener('scrollend', clearProgrammatic, { passive: true });

    track.addEventListener('scroll', () => {
      if (suppressScrollSync || !track.clientWidth) return;
      cancelAnimationFrame(scrollFrame);
      scrollFrame = requestAnimationFrame(() => {
        const nextIndex = getNearestSlideIndex();
        if (programmaticTarget !== null) {
          const targetLeft = getTargetLeft(programmaticTarget);
          if (nextIndex === programmaticTarget && Math.abs(track.scrollLeft - targetLeft) < 2) {
            clearProgrammatic();
          }
          return;
        }
        if (nextIndex !== activeIndex) updateUI(nextIndex);
      });
    }, { passive: true });

    const realignOnResize = () => {
      const width = track.clientWidth;
      if (!width || width === lastWidth) return;
      lastWidth = width;
      goToSlide(activeIndex, true);
    };

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(realignOnResize).observe(track);
    }
    window.addEventListener('resize', realignOnResize, { passive: true });

    window.addEventListener('message', (event) => {
      if (event.origin !== 'https://player.vimeo.com') return;
      let data: { event?: string } | null = null;
      try {
        data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
      } catch {
        return;
      }
      if (!data || (data.event !== 'ended' && data.event !== 'finish')) return;
      slides.forEach((slide) => {
        const iframe = slide.querySelector<HTMLIFrameElement>('.video-card__iframe');
        if (iframe && iframe.contentWindow === event.source) {
          iframe.contentWindow?.postMessage(JSON.stringify({ method: 'unload' }), 'https://player.vimeo.com');
        }
      });
    });

    updateUI(0);
  });
</script>
