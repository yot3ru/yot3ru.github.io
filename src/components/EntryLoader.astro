<div class="entry-loader" data-entry-loader data-phase="waiting" aria-hidden="true">
  <div class="entry-loader__stage" data-entry-stage>
    <span class="entry-loader__ghost" aria-hidden="true"></span>
    <span class="entry-loader__mark">
      <svg
        class="entry-loader__liquid"
        data-entry-wave
        viewBox="0 0 120 220"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="entry-loader__liquid-body"
          d="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16 L128 240 L-8 240 Z"
        >
          <animate
            attributeName="d"
            dur="1.55s"
            repeatCount="indefinite"
            calcMode="spline"
            keyTimes="0;.17;.39;.62;.81;1"
            keySplines=".37 0 .63 1;.31 0 .69 1;.42 0 .58 1;.34 0 .66 1;.39 0 .61 1"
            values="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16 L128 240 L-8 240 Z;
                    M-8 16 C6 19 15 8 29 14 S52 20 65 11 S87 6 101 16 S118 21 128 13 L128 240 L-8 240 Z;
                    M-8 12 C3 17 15 18 29 10 S51 8 64 16 S87 20 101 14 S117 7 128 12 L128 240 L-8 240 Z;
                    M-8 15 C5 7 17 12 28 17 S50 19 64 12 S86 8 100 15 S118 18 128 11 L128 240 L-8 240 Z;
                    M-8 13 C4 20 16 16 28 11 S51 6 65 15 S86 19 100 10 S117 11 128 17 L128 240 L-8 240 Z;
                    M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16 L128 240 L-8 240 Z"
          />
        </path>
        <path
          class="entry-loader__liquid-surface"
          d="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16"
        >
          <animate
            attributeName="d"
            dur="1.55s"
            repeatCount="indefinite"
            calcMode="spline"
            keyTimes="0;.17;.39;.62;.81;1"
            keySplines=".37 0 .63 1;.31 0 .69 1;.42 0 .58 1;.34 0 .66 1;.39 0 .61 1"
            values="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16;
                    M-8 16 C6 19 15 8 29 14 S52 20 65 11 S87 6 101 16 S118 21 128 13;
                    M-8 12 C3 17 15 18 29 10 S51 8 64 16 S87 20 101 14 S117 7 128 12;
                    M-8 15 C5 7 17 12 28 17 S50 19 64 12 S86 8 100 15 S118 18 128 11;
                    M-8 13 C4 20 16 16 28 11 S51 6 65 15 S86 19 100 10 S117 11 128 17;
                    M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16"
          />
        </path>
      </svg>
    </span>
  </div>
</div>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('[data-entry-loader]');
  const stage = loader?.querySelector<HTMLElement>('[data-entry-stage]');

  if (!root.classList.contains('entry-active') || !loader || !stage) {
    loader?.remove();
  } else {
    window.clearTimeout((window as Window & { __lufiEntryFailSafe?: number }).__lufiEntryFailSafe);
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mode = root.dataset.entryMode === 'warm' ? 'warm' : 'cold';
    const startedAt = performance.now();
    if (reducedMotion) {
      stage.querySelector<SVGSVGElement>('[data-entry-wave]')?.pauseAnimations();
    }

    // Intentional build + hold delay before the curtain-lift unveil
    const timing = reducedMotion
      ? { duration: 0, hold: 60, exit: 180, heroDelay: 0 }
      : mode === 'warm'
        ? { duration: 1250, hold: 380, exit: 620, heroDelay: 60 }
        : { duration: 1850, hold: 520, exit: 720, heroDelay: 90 };

    let aborted = false;
    let released = false;
    let assetRatio = 0;
    let assetsDone = false;
    let displayedProgress = 0;
    let tickerFrame = 0;

    const wait = (duration: number) => new Promise<void>((resolve) => window.setTimeout(resolve, duration));
    const nextPaint = () => new Promise<void>((resolve) => {
      requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
    });
    const tabGuard = (event: KeyboardEvent) => {
      if (event.key === 'Tab') event.preventDefault();
    };
    const abort = () => {
      aborted = true;
      cancelAnimationFrame(tickerFrame);
      document.removeEventListener('keydown', tabGuard, true);
    };
    document.addEventListener('keydown', tabGuard, true);
    window.addEventListener('lufi-entry-abort', abort, { once: true });

    const applyVisualProgress = (p: number) => {
      const clamped = Math.max(0, Math.min(1, p));
      loader.style.setProperty('--entry-fill-offset', `${(102 - clamped * 100).toFixed(3)}%`);
    };

    const runProgressTimeline = () => new Promise<void>((resolve) => {
      if (reducedMotion || timing.duration === 0) {
        applyVisualProgress(1);
        resolve();
        return;
      }
      const timelineStart = performance.now();
      const tick = (now: number) => {
        if (aborted) {
          resolve();
          return;
        }
        const elapsed = now - timelineStart;
        const t = Math.min(1, elapsed / timing.duration);
        const timeCurve = t < 0.5
          ? 4 * t * t * t
          : 1 - Math.pow(-2 * t + 2, 3) / 2;

        const ceiling = assetsDone ? 1 : Math.min(0.92, Math.max(0.18, assetRatio));
        const target = Math.min(timeCurve, ceiling);
        displayedProgress += (target - displayedProgress) * (assetsDone && t >= 1 ? 0.28 : 0.18);

        if (assetsDone && t >= 1 && displayedProgress >= 0.994) {
          applyVisualProgress(1);
          resolve();
          return;
        }
        applyVisualProgress(displayedProgress);
        tickerFrame = requestAnimationFrame(tick);
      };
      tickerFrame = requestAnimationFrame(tick);
    });

    const decodeImage = (source: string) => {
      const image = new Image();
      image.decoding = 'async';
      image.src = source;
      return image.decode();
    };
    const materialReady = () => new Promise<void>((resolve) => {
      const material = document.querySelector<HTMLElement>('.hero [data-material]');
      if (!material || ['true', 'fallback'].includes(material.dataset.ready ?? '')) {
        resolve();
        return;
      }
      const done = () => {
        observer.disconnect();
        resolve();
      };
      const observer = new MutationObserver(() => {
        if (['true', 'fallback'].includes(material.dataset.ready ?? '')) done();
      });
      observer.observe(material, { attributes: true, attributeFilter: ['data-ready'] });
    });

    const loadAssets = async () => {
      const images = [...document.images];
      images.forEach((image) => { image.loading = 'eager'; });
      const tasks: Promise<unknown>[] = [
        decodeImage('/img/lufi-mark.svg'),
        materialReady(),
        ...images.map((image) => image.decode()),
      ];
      if (document.fonts) {
        tasks.push(
          document.fonts.load('650 64px Funnel'),
          document.fonts.load('400 64px Zodiak'),
          document.fonts.load('600 16px DM'),
        );
      }

      let complete = 0;
      let failed = 0;
      const counted = tasks.map((task) => Promise.resolve(task).then(
        () => { complete++; },
        () => { complete++; failed++; },
      ).then(() => {
        assetRatio = complete / tasks.length;
      }));

      let emergencyTimeout = 0;
      const emergency = new Promise<void>((resolve) => {
        emergencyTimeout = window.setTimeout(resolve, 60000);
      });
      await Promise.race([Promise.all(counted), emergency]);
      window.clearTimeout(emergencyTimeout);
      assetsDone = true;
      assetRatio = 1;
      root.dataset.entryLoadMs = String(Math.round(performance.now() - startedAt));
      if (complete < tasks.length || failed > 0) root.dataset.entryDegraded = String(tasks.length - complete + failed);
      else root.dataset.entryReady = 'true';
    };

    const release = async () => {
      if (released || aborted) return;
      released = true;
      loader.dataset.phase = 'settling';
      await wait(timing.hold);
      if (aborted) return;

      loader.dataset.phase = 'complete';
      root.style.setProperty('--entry-motion-delay', `${timing.heroDelay}ms`);
      root.classList.add('motion-ready');
      try { sessionStorage.setItem('lufi-entry-seen', '1'); } catch {}

      await nextPaint();
      if (aborted) return;
      loader.style.pointerEvents = 'none';

      if (!reducedMotion) {
        stage.animate(
          [
            { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1.04)' },
            { opacity: 0, transform: 'translate3d(0, -24px, 0) scale(0.96)' },
          ],
          { duration: Math.round(timing.exit * 0.72), easing: 'cubic-bezier(.3, 0, .8, .15)', fill: 'forwards' },
        );
      }

      const exit = loader.animate(
        reducedMotion
          ? [{ opacity: 1 }, { opacity: 0 }]
          : [
              { clipPath: 'inset(0 0 0% 0)', transform: 'translate3d(0, 0%, 0)' },
              { clipPath: 'inset(0 0 100% 0)', transform: 'translate3d(0, -8%, 0)' },
            ],
        {
          duration: timing.exit,
          easing: reducedMotion ? 'ease-out' : 'cubic-bezier(.76, 0, .24, 1)',
          fill: 'forwards',
        },
      );
      try { await exit.finished; } catch {}

      document.removeEventListener('keydown', tabGuard, true);
      window.removeEventListener('lufi-entry-abort', abort);
      loader.remove();
      root.classList.remove('entry-active');
      delete root.dataset.entryMode;
    };

    const run = async () => {
      await nextPaint();
      if (aborted) return;
      loader.dataset.phase = 'forming';
      await Promise.all([loadAssets(), runProgressTimeline()]);
      await release();
    };

    void run();
  }
</script>
