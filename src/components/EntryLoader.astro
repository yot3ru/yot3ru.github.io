<div class="entry-loader" data-entry-loader data-phase="waiting" aria-hidden="true">
  <div class="entry-loader__stage" data-entry-stage>
    <span class="entry-loader__mark">
      <svg
        class="entry-loader__liquid"
        data-entry-wave
        viewBox="0 0 120 220"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="entry-loader__liquid-body"
          d="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16 L128 240 L-8 240 Z"
        >
          <animate
            attributeName="d"
            dur="1.55s"
            repeatCount="indefinite"
            calcMode="spline"
            keyTimes="0;.17;.39;.62;.81;1"
            keySplines=".37 0 .63 1;.31 0 .69 1;.42 0 .58 1;.34 0 .66 1;.39 0 .61 1"
            values="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16 L128 240 L-8 240 Z;
                    M-8 16 C6 19 15 8 29 14 S52 20 65 11 S87 6 101 16 S118 21 128 13 L128 240 L-8 240 Z;
                    M-8 12 C3 17 15 18 29 10 S51 8 64 16 S87 20 101 14 S117 7 128 12 L128 240 L-8 240 Z;
                    M-8 15 C5 7 17 12 28 17 S50 19 64 12 S86 8 100 15 S118 18 128 11 L128 240 L-8 240 Z;
                    M-8 13 C4 20 16 16 28 11 S51 6 65 15 S86 19 100 10 S117 11 128 17 L128 240 L-8 240 Z;
                    M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16 L128 240 L-8 240 Z"
          />
        </path>
        <path
          class="entry-loader__liquid-surface"
          d="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16"
        >
          <animate
            attributeName="d"
            dur="1.55s"
            repeatCount="indefinite"
            calcMode="spline"
            keyTimes="0;.17;.39;.62;.81;1"
            keySplines=".37 0 .63 1;.31 0 .69 1;.42 0 .58 1;.34 0 .66 1;.39 0 .61 1"
            values="M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16;
                    M-8 16 C6 19 15 8 29 14 S52 20 65 11 S87 6 101 16 S118 21 128 13;
                    M-8 12 C3 17 15 18 29 10 S51 8 64 16 S87 20 101 14 S117 7 128 12;
                    M-8 15 C5 7 17 12 28 17 S50 19 64 12 S86 8 100 15 S118 18 128 11;
                    M-8 13 C4 20 16 16 28 11 S51 6 65 15 S86 19 100 10 S117 11 128 17;
                    M-8 14 C3 8 14 20 27 13 S50 7 63 15 S86 21 99 12 S118 9 128 16"
          />
        </path>
      </svg>
    </span>
  </div>
</div>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('[data-entry-loader]');
  const stage = loader?.querySelector<HTMLElement>('[data-entry-stage]');

  if (!root.classList.contains('entry-active') || !loader || !stage) {
    loader?.remove();
  } else {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mode = root.dataset.entryMode === 'warm' ? 'warm' : 'cold';
    if (reducedMotion) {
      stage.querySelector<SVGSVGElement>('[data-entry-wave]')?.pauseAnimations();
    }
    const timing = reducedMotion
      ? { minimum: 180, assets: 280, settle: 60, exit: 160, heroDelay: 0 }
      : mode === 'warm'
        ? { minimum: 720, assets: 800, settle: 180, exit: 300, heroDelay: 25 }
        : { minimum: 1450, assets: 1650, settle: 220, exit: 380, heroDelay: 45 };
    let aborted = false;
    let released = false;

    loader.style.setProperty('--entry-fill-duration', `${timing.minimum}ms`);

    const wait = (duration: number) => new Promise<void>((resolve) => window.setTimeout(resolve, duration));
    const nextPaint = () => new Promise<void>((resolve) => {
      requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
    });
    const tabGuard = (event: KeyboardEvent) => {
      if (event.key === 'Tab') event.preventDefault();
    };
    const abort = () => {
      aborted = true;
      document.removeEventListener('keydown', tabGuard, true);
    };
    document.addEventListener('keydown', tabGuard, true);
    window.addEventListener('lufi-entry-abort', abort, { once: true });

    const fontReady = async () => {
      if (!document.fonts) return;
      await Promise.allSettled([
        document.fonts.load('650 64px Funnel'),
        document.fonts.load('400 64px Zodiak'),
        document.fonts.load('600 16px DM'),
      ]);
    };
    const imageReady = async () => {
      const image = new Image();
      image.src = '/img/chrome-still.svg';
      try { await image.decode(); } catch {}
    };
    const materialReady = () => new Promise<void>((resolve) => {
      if (reducedMotion) {
        resolve();
        return;
      }
      const material = document.querySelector<HTMLElement>('.hero [data-material]');
      if (!material || material.dataset.ready === 'true') {
        requestAnimationFrame(() => resolve());
        return;
      }
      let settled = false;
      const done = () => {
        if (settled) return;
        settled = true;
        observer.disconnect();
        resolve();
      };
      const observer = new MutationObserver(() => {
        if (material.dataset.ready === 'true') requestAnimationFrame(done);
      });
      observer.observe(material, { attributes: true, attributeFilter: ['data-ready'] });
      window.setTimeout(done, mode === 'warm' ? 520 : 1050);
    });

    const release = async () => {
      if (released || aborted) return;
      released = true;
      loader.dataset.phase = 'settling';
      await wait(timing.settle);
      if (aborted) return;

      loader.dataset.phase = 'complete';
      root.style.setProperty('--entry-motion-delay', `${timing.heroDelay}ms`);
      root.classList.add('motion-ready');
      try { sessionStorage.setItem('lufi-entry-seen', '1'); } catch {}

      await nextPaint();
      if (aborted) return;
      loader.style.pointerEvents = 'none';
      const exit = loader.animate(
        [{ opacity: 1 }, { opacity: 0 }],
        { duration: timing.exit, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'forwards' },
      );
      try { await exit.finished; } catch {}

      document.removeEventListener('keydown', tabGuard, true);
      window.removeEventListener('lufi-entry-abort', abort);
      loader.remove();
      root.classList.remove('entry-active');
      delete root.dataset.entryMode;
      window.clearTimeout((window as Window & { __lufiEntryFailSafe?: number }).__lufiEntryFailSafe);
    };

    const run = async () => {
      const assetGate = Promise.race([
        Promise.allSettled([fontReady(), imageReady(), materialReady(), nextPaint()]),
        wait(timing.assets),
      ]);
      await nextPaint();
      if (aborted) return;
      loader.dataset.phase = 'forming';
      await Promise.all([wait(timing.minimum), assetGate]);
      await release();
    };

    void run();
  }
</script>
