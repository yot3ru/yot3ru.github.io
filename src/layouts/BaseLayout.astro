---
import SiteHeader from '../components/SiteHeader.astro';
import EntryLoader from '../components/EntryLoader.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  light?: boolean;
  robots?: string;
}

const {
  title,
  description,
  image = '/img/lufi-social.webp',
  light = false,
  robots = 'index, follow',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class:list={{ 'page-light': light }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <style is:inline>
      html{background:#181715}
      .entry-loader{--entry-fill-offset:102%;display:none;position:fixed;inset:0;z-index:2147483647;place-items:center;width:100%;height:100svh;min-height:100svh;background:#181715;opacity:1;pointer-events:auto;contain:strict;will-change:opacity}
      @supports(height:100dvh){.entry-loader{height:100dvh}}
      html[data-entry-mode] .entry-loader{display:grid}
      html.entry-active,html.entry-active body{overflow:hidden}
      .entry-loader__stage{position:relative;width:clamp(4.8rem,12vw,7.25rem);aspect-ratio:879/1654;transform:translateZ(0)}
      .entry-loader__mark{position:absolute;inset:0;overflow:hidden;-webkit-mask:url('/img/lufi-mark.svg') center/contain no-repeat;mask:url('/img/lufi-mark.svg') center/contain no-repeat}
      .entry-loader__liquid{position:absolute;top:-8%;left:-12%;width:124%;height:120%;overflow:visible;transform:translate3d(0,var(--entry-fill-offset),0);transition:transform 480ms cubic-bezier(.37,0,.22,1);will-change:transform}
      .entry-loader__liquid-body{fill:#ebe7e0}
      .entry-loader__liquid-surface{fill:none;stroke:#cd474c;stroke-width:2;stroke-linecap:round;vector-effect:non-scaling-stroke;opacity:.9;transition:opacity 180ms ease}
      .entry-loader[data-phase="settling"] .entry-loader__liquid,.entry-loader[data-phase="complete"] .entry-loader__liquid{transform:translate3d(0,-8%,0);transition-duration:220ms;transition-timing-function:cubic-bezier(.22,1,.36,1)}
      .entry-loader[data-phase="settling"] .entry-loader__liquid-surface,.entry-loader[data-phase="complete"] .entry-loader__liquid-surface{opacity:0}
      @media(prefers-reduced-motion:reduce){.entry-loader__liquid{transition:none}.entry-loader__liquid-surface{display:none}}
    </style>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let mode = 'cold';
        try {
          const seen = sessionStorage.getItem('lufi-entry-seen') === '1';
          mode = seen ? 'warm' : 'cold';
        } catch {}
        root.dataset.entryMode = mode;
        root.classList.add('entry-active');
        window.__lufiEntryFailSafe = window.setTimeout(() => {
          window.dispatchEvent(new Event('lufi-entry-abort'));
          const loader = document.querySelector('[data-entry-loader]');
          root.classList.add('motion-ready');
          const finish = () => {
            loader?.remove();
            root.classList.remove('entry-active');
            delete root.dataset.entryMode;
          };
          if (!loader) {
            finish();
            return;
          }
          loader.style.pointerEvents = 'none';
          loader.style.transition = 'opacity 220ms cubic-bezier(.22,1,.36,1)';
          requestAnimationFrame(() => { loader.style.opacity = '0'; });
          window.setTimeout(finish, 240);
        }, 60000);
      })();
    </script>
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content={light ? '#EBE7E0' : '#181715'} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LUFI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LUFI — independent creative studio" />
    <meta property="og:locale" content="en_LK" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="LUFI — independent creative studio" />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/FunnelDisplay-0.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Zodiak-Italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans-0.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/img/lufi-mark.svg" as="image" type="image/svg+xml" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <EntryLoader />
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <div class="custom-cursor" data-cursor-overlay aria-hidden="true">
      <svg class="custom-cursor__shape" width="50" height="54" viewBox="0 0 50 54" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g filter="url(#smooth-cursor-shadow)">
          <path d="M42.6817 41.1495 27.5103 6.79925c-.7834-1.77368-3.3021-1.77367-4.1176 0L7.59814 41.1495c-.83981 1.8264.92898 3.7407 2.81436 3.0459l13.9632-5.1458a2.25 2.25 0 0 1 1.5665 0l13.8699 5.1458c1.8728.6948 3.6763-1.2195 2.8696-3.0459Z" class="custom-cursor__fill" />
          <path d="M43.7146 40.6933 28.5431 6.34306c-1.1875-2.68878-4.9659-2.6479-6.1763-.01551L6.57226 40.6778c-1.25886 2.7378 1.40012 5.6202 4.23074 4.5771l13.9632-5.1459c.2559-.0943.5337-.0934.7832-.0008l13.8699 5.1458c2.8068 1.0413 5.5061-1.8193 4.2953-4.5607Z" class="custom-cursor__outline" stroke-width="2.25825" />
        </g>
        <defs>
          <filter id="smooth-cursor-shadow" x=".602" y=".952" width="49.059" height="52.428" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
            <feDropShadow dy="2.258" stdDeviation="2.258" flood-opacity=".08" />
          </filter>
        </defs>
      </svg>
    </div>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const motionStyles = getComputedStyle(document.documentElement);
      const motionTime = (token: string, fallback: number) => Number.parseFloat(motionStyles.getPropertyValue(token)) || fallback;
      const motion = {
        micro: motionTime('--duration-micro', 160),
        fast: motionTime('--duration-fast', 240),
        base: motionTime('--duration-base', 450),
        reveal: motionTime('--duration-reveal', 650),
        ease: motionStyles.getPropertyValue('--ease-out-primary').trim() || 'cubic-bezier(.22,1,.36,1)',
        soft: motionStyles.getPropertyValue('--ease-out-soft').trim() || 'cubic-bezier(.16,1,.3,1)',
      };
      const menu = document.querySelector('[data-menu]');
      const openMenu = document.querySelector('[data-menu-open]');
      const closeMenu = document.querySelector('[data-menu-close]');
      if (menu instanceof HTMLDialogElement && openMenu instanceof HTMLButtonElement) {
        let closing = false;
        const openDialog = () => {
          if (menu.open) return;
          const cursorLayer = document.querySelector<HTMLElement>('[data-cursor-overlay]');
          if (cursorLayer) menu.append(cursorLayer);
          menu.showModal();
          if (reduce.matches) return;
          menu.animate(
            [{ opacity: 0 }, { opacity: 1 }],
            { duration: motion.base, easing: motion.ease },
          );
          menu.querySelector('.menu__inner')?.animate(
            [{ opacity: .82, transform: 'translate3d(0,12px,0)' }, { opacity: 1, transform: 'none' }],
            { duration: motion.base, easing: motion.soft },
          );
          menu.querySelectorAll('nav a').forEach((link, index) => link.animate(
            [{ opacity: 0, transform: 'translate3d(0,8px,0)' }, { opacity: 1, transform: 'none' }],
            { duration: motion.base, delay: motion.micro * .35 + Math.min(index, 3) * motion.micro * .25, easing: motion.ease, fill: 'backwards' },
          ));
        };
        const closeDialog = async () => {
          if (!menu.open || closing) return;
          if (reduce.matches) {
            menu.close();
            const cursorLayer = menu.querySelector<HTMLElement>('[data-cursor-overlay]');
            if (cursorLayer) document.body.append(cursorLayer);
            return;
          }
          closing = true;
          const animation = menu.animate(
            [{ opacity: 1 }, { opacity: 0 }],
            { duration: motion.fast, easing: 'cubic-bezier(.4,0,1,1)' },
          );
          try { await animation.finished; } catch {}
          menu.close();
          const cursorLayer = menu.querySelector<HTMLElement>('[data-cursor-overlay]');
          if (cursorLayer) document.body.append(cursorLayer);
          closing = false;
        };
        openMenu.addEventListener('click', openDialog);
        closeMenu?.addEventListener('click', closeDialog);
        menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeDialog));
        menu.addEventListener('click', (event) => { if (event.target === menu) closeDialog(); });
        menu.addEventListener('cancel', (event) => { event.preventDefault(); closeDialog(); });
      }

      const capability = document.querySelector('[data-capability]');
      if (capability instanceof HTMLElement) {
        const buttons = [...capability.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const panels = [...capability.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
        const panelTimers = new WeakMap<HTMLElement, number>();
        const activate = (button: HTMLButtonElement) => {
          if (button.getAttribute('aria-selected') === 'true') return;
          buttons.forEach((item) => {
            const selected = item === button;
            item.setAttribute('aria-selected', String(selected));
            item.setAttribute('tabindex', selected ? '0' : '-1');
          });
          panels.forEach((panel) => {
            const selected = panel.id === button.getAttribute('aria-controls');
            panel.hidden = !selected;
            if (selected && !reduce.matches) {
              const previousTimer = panelTimers.get(panel);
              if (previousTimer) window.clearTimeout(previousTimer);
              delete panel.dataset.entering;
              requestAnimationFrame(() => {
                panel.dataset.entering = '';
                panelTimers.set(panel, window.setTimeout(() => {
                  delete panel.dataset.entering;
                  panelTimers.delete(panel);
                }, motion.base + motion.micro * .5));
              });
            }
          });
          capability.dataset.active = button.dataset.key;
        };
        buttons.forEach((button, index) => {
          button.addEventListener('click', () => activate(button));
          button.addEventListener('keydown', (event) => {
            if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
            event.preventDefault();
            const step = ['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1;
            const next = buttons[(index + step + buttons.length) % buttons.length];
            activate(next);
            next.focus();
          });
        });
      }

      const cursor = document.querySelector<HTMLElement>('[data-cursor-overlay]');
      const fine = matchMedia('(any-hover: hover) and (any-pointer: fine)');
      if (cursor) {
        const spring = { damping: 45, stiffness: 400, mass: 1 };
        const rotationSpring = { damping: 60, stiffness: 300, mass: 1 };
        const scaleSpring = { damping: 35, stiffness: 500, mass: 1 };
        let enabled = false;
        let visible = false;
        let targetX = 0;
        let targetY = 0;
        let x = 0;
        let y = 0;
        let velocityX = 0;
        let velocityY = 0;
        let targetRotation = 0;
        let rotation = 0;
        let rotationVelocity = 0;
        let previousAngle = 0;
        let targetScale = 1;
        let scale = 1;
        let scaleVelocity = 0;
        let previousX = 0;
        let previousY = 0;
        let previousPointerTime = performance.now();
        let frameId = 0;
        let lastFrame = performance.now();
        let settleTimer = 0;

        const eligible = () => fine.matches && !reduce.matches;
        const stepSpring = (value: number, speed: number, target: number, config: typeof spring, delta: number) => {
          const acceleration = ((target - value) * config.stiffness - speed * config.damping) / config.mass;
          const nextSpeed = speed + acceleration * delta;
          return [value + nextSpeed * delta, nextSpeed] as const;
        };
        const disableCursor = () => {
          enabled = false;
          visible = false;
          cursor.removeAttribute('data-visible');
          delete document.documentElement.dataset.cursorReady;
          cancelAnimationFrame(frameId);
          clearTimeout(settleTimer);
          frameId = 0;
        };
        const render = (now: number) => {
          frameId = 0;
          if (!enabled || !visible || document.hidden) return;
          const delta = Math.min((now - lastFrame) / 1000, 1 / 30);
          lastFrame = now;
          [x, velocityX] = stepSpring(x, velocityX, targetX, spring, delta);
          [y, velocityY] = stepSpring(y, velocityY, targetY, spring, delta);
          [rotation, rotationVelocity] = stepSpring(rotation, rotationVelocity, targetRotation, rotationSpring, delta);
          [scale, scaleVelocity] = stepSpring(scale, scaleVelocity, targetScale, scaleSpring, delta);
          cursor.style.transform = `translate3d(${x}px,${y}px,0) translate(-50%,-50%) rotate(${rotation}deg) scale(${scale})`;
          const moving = Math.abs(targetX - x) > .01 || Math.abs(targetY - y) > .01
            || Math.abs(targetRotation - rotation) > .01 || Math.abs(targetScale - scale) > .001
            || Math.abs(velocityX) > .01 || Math.abs(velocityY) > .01
            || Math.abs(rotationVelocity) > .01 || Math.abs(scaleVelocity) > .001;
          if (moving) frameId = requestAnimationFrame(render);
        };
        const startLoop = () => {
          if (frameId || !enabled || !visible || document.hidden) return;
          lastFrame = performance.now();
          frameId = requestAnimationFrame(render);
        };

        addEventListener('pointermove', (event) => {
          if (event.pointerType === 'touch' || !eligible()) return;
          if (!enabled) {
            enabled = true;
            document.documentElement.dataset.cursorReady = 'true';
          }
          const now = performance.now();
          const deltaTime = Math.max(now - previousPointerTime, 1);
          const dx = event.clientX - previousX;
          const dy = event.clientY - previousY;
          const speed = Math.hypot(dx / deltaTime, dy / deltaTime);
          targetX = event.clientX;
          targetY = event.clientY;
          if (!visible) {
            visible = true;
            x = targetX;
            y = targetY;
            cursor.dataset.visible = 'true';
          }
          if (speed > .1) {
            const currentAngle = Math.atan2(dy, dx) * 180 / Math.PI + 90;
            let difference = currentAngle - previousAngle;
            if (difference > 180) difference -= 360;
            if (difference < -180) difference += 360;
            targetRotation += difference;
            previousAngle = currentAngle;
            targetScale = .95;
            clearTimeout(settleTimer);
            settleTimer = window.setTimeout(() => {
              targetScale = 1;
              startLoop();
            }, 150);
          }
          previousX = event.clientX;
          previousY = event.clientY;
          previousPointerTime = now;
          startLoop();
        }, { passive: true });
        document.documentElement.addEventListener('pointerleave', () => {
          visible = false;
          cursor.removeAttribute('data-visible');
          cancelAnimationFrame(frameId);
          frameId = 0;
        });
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            cancelAnimationFrame(frameId);
            frameId = 0;
          } else startLoop();
        });
        fine.addEventListener('change', () => { if (!eligible()) disableCursor(); });
        reduce.addEventListener('change', () => { if (!eligible()) disableCursor(); });
      }

      const motionSections = [...document.querySelectorAll<HTMLElement>('[data-motion-section]')];
      if (!reduce.matches && 'IntersectionObserver' in window) {
        const reveal = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) (entry.target as HTMLElement).dataset.inView = '';
            else delete (entry.target as HTMLElement).dataset.inView;
          });
        }, { threshold: 0, rootMargin: '0px 0px -15% 0px' });
        motionSections.forEach((section) => reveal.observe(section));
      } else {
        motionSections.forEach((section) => section.dataset.inView = '');
      }
      if (!document.documentElement.classList.contains('entry-active')) {
        requestAnimationFrame(() => document.documentElement.classList.add('motion-ready'));
      }
    </script>
  </body>
</html>
