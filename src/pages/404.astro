---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found — LUFI" description="The page could not be found. Return to LUFI." robots="noindex, follow">
  <section class="not-found" data-surface="dark" style="min-height:80svh;padding:9rem var(--p) 5rem;background:var(--ink);color:var(--bone);display:flex;flex-direction:column;justify-content:center;gap:2rem">
    <p style="font-size:.75rem;text-transform:uppercase;letter-spacing:.12em">404 / Page not found</p>
    <h1 style="font:650 clamp(4rem,15vw,10rem)/.9 Funnel,sans-serif;letter-spacing:-.06em">Wrong turn.<br/><em>New direction.</em></h1>
    <a href="/" style="display:inline-flex;align-items:center;gap:.45em;text-decoration:underline;text-underline-offset:.3em;width:max-content">Back to LUFI <Icon name="arrow-up-right" class="inline-arrow" /></a>
  </section>
</BaseLayout>
