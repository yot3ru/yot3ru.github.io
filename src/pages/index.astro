---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LivingMaterial from '../components/LivingMaterial.astro';
import LabGallery from '../components/LabGallery.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import { photographyRows } from '../data/photographyWork';

const capabilities = [
  { key: 'identity', name: 'Graphic design', detail: 'Identities, campaigns and visual systems built to be recognized, then used.', proof: 'Type, image and hierarchy in one visual language.', image: '/img/cap-identity.webp', small: '/img/cap-identity-640.webp', width: 900, height: 1200, alt: 'Tarot card I: Light Academia engraving of a drafting compass, fountain pen, stacked books, olive branches and a Cinnabar sun.' },
  { key: 'film', name: 'Film & motion', detail: 'Edit, titles and moving images with a reason for every frame.', proof: 'Pace, cut and feeling working together.', image: '/img/cap-film.webp', small: '/img/cap-film-640.webp', width: 900, height: 1200, alt: 'Tarot card II: Light Academia engraving of a celestial film reel, winged hourglasses, crescent moons and Cinnabar rays.' },
  { key: 'image', name: 'Photography', detail: 'Images with clear framing, light and intent—from product to people and place.', proof: 'Art direction before the shutter.', image: '/img/cap-photography.webp', small: '/img/cap-photography-640.webp', width: 900, height: 1200, alt: 'Tarot card III: Light Academia engraving of a vintage camera obscura lens eye framed by prisms, laurel wreaths and a Cinnabar eclipse.' },
  { key: 'production', name: 'Video production', detail: 'A visual idea carried from shoot planning through the final cut.', proof: 'A point of view that survives production.', image: '/img/cap-production.webp', small: '/img/cap-production-640.webp', width: 900, height: 1200, alt: 'Tarot card IV: Light Academia engraving of a classical theatre arch with a cinema projector casting a Cinnabar light beam.' },
  { key: 'digital', name: 'Digital experiences', detail: 'Websites and interfaces that are clear to use and distinctive to see.', proof: 'Structure and interaction that earn their place.', image: '/img/cap-digital.webp', small: '/img/cap-digital-640.webp', width: 900, height: 1200, alt: 'Tarot card V: Light Academia engraving of an antique astrolabe, geometric portal, Cinnabar constellations and a sculpted hand.' },
];
---

<BaseLayout title="LUFI — Independent creative studio" description="LUFI is an independent creative studio in Colombo. We make identities, images, film and digital experiences with a clear point of view.">
  <section class="hero" id="start" aria-labelledby="hero-title" data-surface="dark">
    <div class="hero__field"><LivingMaterial priority /></div>
    <div class="hero__content">
      <h1 id="hero-title" class="hero__statement" aria-label="Make something worth noticing."><span class="motion-line"><span>Make something</span></span><span class="motion-line"><em class="hero__phrase" aria-hidden="true" data-hero-phrase>worth noticing.</em></span></h1>
    </div>
  </section>

  <section class="intro section-pad" id="point-of-view" aria-labelledby="intro-title" data-motion-section data-surface="light">
    <div class="intro__grid">
      <h2 id="intro-title" class="motion-heading"><span class="motion-line"><span>Good design</span></span><span class="motion-line"><span>has a <em>point.</em></span></span></h2>
      <div class="intro__copy">
        <p>LUFI makes identities, images, film and digital experiences for people with something to say.</p>
        <p>We look for the idea first. Then we give it form, a voice and a life beyond the presentation.</p>
      </div>
    </div>
  </section>

  <section class="capabilities section-pad" id="capabilities" aria-labelledby="capabilities-title" data-capability data-active="identity" data-motion-section data-surface="dark">
    <div class="section-heading capabilities__header">
      <h2 id="capabilities-title" class="motion-heading">
        <span class="motion-line capabilities__title-main"><span>The work<br />takes</span></span>
        <span class="motion-line capabilities__title-accent"><span><em>different<br />forms.</em></span></span>
      </h2>
    </div>
    <div class="capabilities__layout">
      <div class="capabilities__tabs" role="tablist" aria-label="LUFI capabilities" aria-orientation="vertical">
        {capabilities.map((item, index) => (
          <div class="capability-item" data-selected={index === 0 ? 'true' : 'false'}>
            <button
              class="capability-tab"
              type="button"
              role="tab"
              id={`tab-${item.key}`}
              aria-controls={`panel-${item.key}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-key={item.key}
            >
              <span class="capability-tab__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="capability-tab__name">{item.name}</span>
              <span class="capability-tab__arrow" aria-hidden="true"><Icon name="arrow-up-right" /></span>
            </button>
            <div class="capability-panel" role="tabpanel" id={`panel-${item.key}`} aria-labelledby={`tab-${item.key}`} hidden={index !== 0}>
              <p class="capability-panel__detail">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="capabilities__panels">
        <div class="capabilities__deck" data-capability-deck aria-hidden="true">
          {capabilities.map((item, index) => (
            <figure class="tarot-card" data-card-index={index} data-offset={index}>
              <img
                src={item.image}
                srcset={`${item.small} 480w, ${item.image} ${item.width}w`}
                sizes="(min-width: 760px) 22rem, 78vw"
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="eager"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <LabGallery />

  <section class="thinking section-pad" id="thinking" aria-labelledby="thinking-title" data-motion-section data-surface="dark">
    <div class="thinking__grid">
      <div class="thinking__statement">
        <h2 id="thinking-title" class="motion-heading"><span class="motion-line"><span>We don't start</span></span><span class="motion-line"><span>with the <em>surface.</em></span></span></h2>
        <p class="thinking__lead">A visual can get attention. An idea gives it somewhere to go.</p>
      </div>
      <div class="thinking__right">
        <ol class="principles"><li><strong>Find what matters.</strong><span>Understand the thing before making it look like anything.</span></li><li><strong>Give it a shape.</strong><span>Build a visual language people can recognize and use.</span></li><li><strong>Keep the necessary.</strong><span>Remove what distracts from the point.</span></li><li><strong>Make it move with purpose.</strong><span>Let every frame and interaction carry the idea.</span></li></ol>
      </div>
    </div>
  </section>

  <LabGallery rows={photographyRows} id="photography" title="Photography." imageRoot="/img/photography" />

  <section class="studio section-pad" id="studio" aria-labelledby="studio-title" data-motion-section data-surface="dark">
    <div class="studio__layout"><div class="studio__mark" aria-hidden="true"><LivingMaterial /><img src="/img/lufi-mark.svg" width="879" height="1654" alt="" /></div><div class="studio__copy"><h2 id="studio-title" class="motion-heading"><span class="motion-line"><span>Small enough</span></span><span class="motion-line"><span>to <em>care.</em></span></span></h2><p>LUFI is an independent creative studio in Colombo, Sri Lanka. We work across graphic design, photography, video and digital experiences.</p><p>We care about the thought behind the work, and the details that make it hold together.</p></div></div>
  </section>

  <VideoShowcase />

  <ReviewsSection />
</BaseLayout>

<script>
  const heroPhrase = document.querySelector<HTMLElement>('[data-hero-phrase]');
  if (heroPhrase) {
    const phrases = [
      'worth noticing.',
      'feel good.',
      'feel alive.',
      'feel human.',
      'mean more.',
      'move people.',
      'last longer.',
      'worth keeping.',
      'worth sharing.',
      'with purpose.',
      'with feeling.',
      'that matters.',
      'that connects.',
      'that stays.',
      'feel different.',
      'feel possible.',
      'spark curiosity.',
      'start a story.',
      'bring us closer.',
      'worth revisiting.',
      'be remembered.',
      'make sense.',
    ];
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const motionStyles = getComputedStyle(document.documentElement);
    const motionTime = (token: string, fallback: number) => Number.parseFloat(motionStyles.getPropertyValue(token)) || fallback;
    const phraseMotion = {
      fast: Math.max(motionTime('--duration-fast', 240), 380),
      base: Math.max(motionTime('--duration-base', 450), 620),
      soft: motionStyles.getPropertyValue('--ease-out-soft').trim() || 'cubic-bezier(.16,1,.3,1)',
    };
    const firstLetter = (phrase: string) => phrase[0].toLowerCase();
    const makeQueue = (items: string[], previousLetters: string[]) => {
      for (let attempt = 0; attempt < 200; attempt++) {
        const remaining = [...items];
        const order: string[] = [];
        let recentLetters = [...previousLetters];
        while (remaining.length > 0) {
          const counts = new Map<string, number>();
          remaining.forEach((phrase) => counts.set(firstLetter(phrase), (counts.get(firstLetter(phrase)) ?? 0) + 1));
          const choices = remaining.filter((phrase) => !recentLetters.includes(firstLetter(phrase)));
          if (choices.length === 0) break;
          let pick = Math.random() * choices.reduce((total, phrase) => total + (counts.get(firstLetter(phrase)) ?? 0), 0);
          let chosen = choices[choices.length - 1];
          for (const phrase of choices) {
            pick -= counts.get(firstLetter(phrase)) ?? 0;
            if (pick < 0) { chosen = phrase; break; }
          }
          remaining.splice(remaining.indexOf(chosen), 1);
          order.push(chosen);
          recentLetters = [...recentLetters.slice(-1), firstLetter(chosen)];
        }
        if (remaining.length === 0) return order;
      }
      throw new Error('Unable to order hero phrases');
    };
    let recentLetters = [firstLetter(phrases[0])];
    let queue = makeQueue(phrases.slice(1), recentLetters);
    let inView = false;
    let running = false;
    let timer: number | undefined;
    let currentAnimation: Animation | undefined;

    const stop = () => {
      running = false;
      clearTimeout(timer);
      currentAnimation?.cancel();
      currentAnimation = undefined;
    };
    const advance = async () => {
      if (!running) return;
      const exit = heroPhrase.animate(
        [{ opacity: 1, transform: 'translate3d(0,0,0)' }, { opacity: 0, transform: 'translate3d(0,-.38em,0)' }],
        { duration: phraseMotion.fast, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' },
      );
      currentAnimation = exit;
      try { await exit.finished; } catch { return; }
      if (!running) return;

      if (queue.length === 0) queue = makeQueue(phrases, recentLetters);
      const nextPhrase = queue.shift()!;
      heroPhrase.textContent = nextPhrase;
      recentLetters = [...recentLetters.slice(-1), firstLetter(nextPhrase)];
      exit.cancel();
      const enter = heroPhrase.animate(
        [{ opacity: 0, transform: 'translate3d(0,.42em,0)' }, { opacity: 1, transform: 'translate3d(0,0,0)' }],
        { duration: phraseMotion.base, easing: phraseMotion.soft, fill: 'forwards' },
      );
      currentAnimation = enter;
      try { await enter.finished; } catch { return; }
      enter.cancel();
      currentAnimation = undefined;
      if (running) timer = window.setTimeout(advance, 3800);
    };
    const start = () => {
      if (running) return;
      running = true;
      timer = window.setTimeout(advance, 3200);
    };
    const sync = () => {
      const pageReady = document.documentElement.classList.contains('motion-ready');
      if (inView && pageReady && !document.hidden && !reducedMotion.matches) start();
      else stop();
      if (reducedMotion.matches) {
        heroPhrase.textContent = phrases[0];
        recentLetters = [firstLetter(phrases[0])];
        queue = makeQueue(phrases.slice(1), recentLetters);
      }
    };
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    }, { threshold: .2 }).observe(heroPhrase);
    document.addEventListener('visibilitychange', sync);
    reducedMotion.addEventListener('change', sync);
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

</script>
